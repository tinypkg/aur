# Maintainer: czyt <czytcn@gmail.com>
pkgname=little-snitch-bin
pkgver=1.0.3
pkgrel=1
pkgdesc="Little Snitch informs you whenever a program attempts to establish an outgoing Internet connection"
arch=('x86_64' 'aarch64')
url="https://obdev.at/products/littlesnitch"
license=('custom')
depends=('gtk3' 'libnotify' 'polkit')
provides=('little-snitch')
conflicts=('little-snitch')
options=('!strip')
source_x86_64=("littlesnitch_${pkgver}_amd64.deb::https://obdev.at/downloads/littlesnitch-linux/littlesnitch_${pkgver}_amd64.deb")
source_aarch64=("littlesnitch_${pkgver}_arm64.deb::https://obdev.at/downloads/littlesnitch-linux/littlesnitch_${pkgver}_arm64.deb")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local _debfile
    if [[ "$CARCH" == "x86_64" ]]; then
        _debfile="littlesnitch_${pkgver}_amd64.deb"
    else
        _debfile="littlesnitch_${pkgver}_arm64.deb"
    fi

    # Extract the deb package
    ar p "${srcdir}/${_debfile}" data.tar.gz | tar xz -C "${pkgdir}"

    # Fix permissions
    chmod -R u=rwX,go=rX "${pkgdir}"
}