# Maintainer: czyt <czytcn@gmail.com>
pkgname=superfile-bin
pkgver=1.6.0
pkgrel=1
pkgdesc="Pretty fancy and modern terminal file manager"
arch=('x86_64' 'aarch64')
url="https://superfile.dev"
license=('MIT')
provides=('superfile')
conflicts=('superfile')
options=('!strip' '!debug')

source=("superfile-${pkgver}-LICENSE::https://raw.githubusercontent.com/yorukot/superfile/v${pkgver}/LICENSE")
source_x86_64=("superfile-linux-v${pkgver}-amd64.tar.gz::https://github.com/yorukot/superfile/releases/download/v${pkgver}/superfile-linux-v${pkgver}-amd64.tar.gz")
source_aarch64=("superfile-linux-v${pkgver}-arm64.tar.gz::https://github.com/yorukot/superfile/releases/download/v${pkgver}/superfile-linux-v${pkgver}-arm64.tar.gz")
sha256sums=('SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local _arch
    case "$CARCH" in
        x86_64)  _arch=amd64 ;;
        aarch64) _arch=arm64 ;;
    esac

    install -Dm755 "${srcdir}/dist/superfile-linux-v${pkgver}-${_arch}/spf" \
        "${pkgdir}/usr/bin/spf"
    install -Dm644 "${srcdir}/superfile-${pkgver}-LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
